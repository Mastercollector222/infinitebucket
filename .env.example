# Supabase (publishable anon key only — no service_role, no Supabase Auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary (server-side only — the secret must NEVER get a NEXT_PUBLIC_ prefix).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=ib_avatars

# Chain + token (defaults shown — only override if needed).
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_TOKEN=0xbd305151d3d7eb612d3969e9fa05315cd47374e4
NEXT_PUBLIC_RPC=https://rpc.mainnet.chain.robinhood.com

# Canonical site URL, used for metadata / Open Graph / token image.
# Defaults to https://infinitebucket.net when unset.
NEXT_PUBLIC_SITE_URL=https://infinitebucket.net

# Optional social link overrides. Defaults point to the official channels
# (https://x.com/InfinityBucket_ and https://t.me/InfiniteBucket).
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# ── Shop ─────────────────────────────────────────────────────────────────
# Wallet that receives shop payments (public — shown on the checkout screen).
NEXT_PUBLIC_SHOP_WALLET=

# Comma-separated lowercase admin wallet addresses — only these see
# /admin/shop. Public list; security comes from the signature check in
# /api/admin/shop.
NEXT_PUBLIC_ADMIN_WALLETS=

# Supabase service-role key — SERVER ONLY. Required for all shop writes
# (orders, products, tiers, settings) which are mediated by signed API
# routes while RLS blocks direct anon writes. NEVER give this a
# NEXT_PUBLIC_ prefix — it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Flat shipping fee in USDG, added to every order (default 6).
SHIPPING_USD=6

# Optional: 32-byte hex key for AES-256-GCM encryption of shipment PII at
# rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, address fields store plaintext (still RLS + service-role only).
SHIPPING_ENCRYPTION_KEY=
