# WalletConnect Cloud project id — required for the Connect modal / WalletConnect.
# Get one at https://cloud.reown.com (formerly WalletConnect Cloud).
NEXT_PUBLIC_WC_PROJECT_ID=

# Canonical site URL, used for metadata / Open Graph / token image.
# Defaults to https://infinitebucket.net when unset.
NEXT_PUBLIC_SITE_URL=https://infinitebucket.net

# Optional social link overrides. Defaults point to the official channels
# (https://x.com/InfinityBucket_ and https://t.me/InfiniteBucket). Set these to
# override, or leave blank to use the defaults.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
